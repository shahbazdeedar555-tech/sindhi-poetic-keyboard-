            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_kaf"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ڪ"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_gaf"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="گ"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_lam"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ل"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_meem"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="م"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

    </LinearLayout>

    <!-- ROW 6 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_noon"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ن"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_waw"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="و"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_hay2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
