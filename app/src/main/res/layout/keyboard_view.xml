            android:layout_weight="1"
            android:layout_margin="3dp"
            android:gravity="center"
            android:background="#FFFFFF"
            android:text="پ"
            android:textColor="#000000"
            android:textSize="30sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
