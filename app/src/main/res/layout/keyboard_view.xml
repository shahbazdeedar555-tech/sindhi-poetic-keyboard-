                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.8"
                android:minWidth="0dp"
                android:padding="0dp"
                style="@style/KeyboardButton"/>

        </LinearLayout>


        <!-- ROW 5 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_tatweel"
                android:text="ڊگهو ڪرڻ واري"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:minWidth="0dp"
                android:padding="0dp"
                style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_zabar1" android:text="َ"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_zer1" android:text="ِ"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_pesh1" android:text="ُ"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

