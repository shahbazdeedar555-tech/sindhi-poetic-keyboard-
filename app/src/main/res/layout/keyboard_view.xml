                style="@style/KeyboardButton"/>

            <Button
                android:id="@+id/key_space2"
                android:text="SPACE"
                style="@style/KeyboardButton"/>

        </LinearLayout>

        <!-- ROW 5 : SPECIALS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layoutDirection="rtl">

            <Button android:id="@+id/key_tatweel2" android:text="ـ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_baha2" android:text="بہ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_taha2" android:text="تہ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_noha2" android:text="نہ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_yeh_alt2" android:text="ى" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_heh_alt2" android:text="ہ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_waw_hamza2" android:text="ؤ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_teh_marbuta2" android:text="ة" style="@style/KeyboardButton"/>

        </LinearLayout>

        <!-- ROW 6 : DIACRITICS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layoutDirection="rtl">

            <Button android:id="@+id/key_zabar2" android:text="َ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_zer2" android:text="ِ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_pesh2" android:text="ُ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_shadd2" android:text="ّ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_jazm2" android:text="ْ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/key_alif_khanjari2b" android:text="ٰ" style="@style/KeyboardButton"/>
