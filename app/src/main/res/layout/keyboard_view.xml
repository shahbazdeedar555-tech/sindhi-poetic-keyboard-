        );

        setDelete(
                R.id.key_delete_bottom2
        );

        setSpace(
                R.id.key_space_bottom2
        );

        setEnter(
                R.id.key_enter_bottom2
        );
    }


    // =========================================================
    // NORMAL KEY
    // =========================================================

    private void setKey(
            int id,
            final String text
    ) {

        Button button =
                keyboard.findViewById(id);

        if (button == null) {
            return;
        }

        button.setOnClickListener(
                new View.OnClickListener() {

                    @Override
                    public void onClick(View v) {

                        InputConnection ic =
                                getCurrentInputConnection();

                        if (ic == null) {
                            return;
                        }

                        ic.commitText(
                                text,
                                1
                        );
                    }
                }
        );
    }


    // =========================================================
    // SHIFT - PAGE 1 TO PAGE 2
    // =========================================================

    private void setShift(int id) {

        Button button =
                keyboard.findViewById(id);

        if (button == null) {
            return;
        }

        button.setOnClickListener(
                new View.OnClickListener() {

                    @Override
                    public void onClick(View v) {

                        shiftOn = true;

                        page1.setVisibility(
                                View.GONE
                        );

                        page2.setVisibility(
                                View.VISIBLE
                        );
                    }
                }
        );
    }


    // =========================================================
    // SHIFT - PAGE 2 TO PAGE 1
    // =========================================================

    private void setShift2(int id) {

        Button button =
                keyboard.findViewById(id);

        if (button == null) {
            return;
        }

        button.setOnClickListener(
                new View.OnClickListener() {

                    @Override
                    public void onClick(View v) {

                        shiftOn = false;

                        page2.setVisibility(
                                View.GONE
                        );

                        page1.setVisibility(
                                View.VISIBLE
                        );
                    }
                }
        );
    }


    // =========================================================
    // DELETE + LONG PRESS
    // =========================================================

    private void setDelete(int id) {

        Button button =
                keyboard.findViewById(id);

        if (button == null) {
            return;
        }

        button.setOnTouchListener(
                new View.OnTouchListener() {

                    @Override
                    public boolean onTouch(
                            View v,
                            MotionEvent event) {

                        switch (
                                event.getAction()
                        ) {

                            case MotionEvent.ACTION_DOWN:

                                deleteHolding = true;

                                deleteOneCharacter();

                                deleteHandler.postDelayed(
                                        deleteRunnable,
                                        400
                                );

                                return true;


                            case MotionEvent.ACTION_UP:

                            case MotionEvent.ACTION_CANCEL:

                                deleteHolding = false;

                                deleteHandler.removeCallbacks(
                                        deleteRunnable
                                );

                                return true;
                        }

                        return false;
                    }
                }
        );
    }


    // =========================================================
    // DELETE ONE CHARACTER
    // =========================================================

    private void deleteOneCharacter() {

        InputConnection ic =
                getCurrentInputConnection();

        if (ic == null) {
            return;
        }

        ic.deleteSurroundingText(
                1,
                0
        );
    }


    // =========================================================
    // SPACE
    // =========================================================

    private void setSpace(int id) {

        Button button =
                keyboard.findViewById(id);

        if (button == null) {
            return;
        }

        button.setOnClickListener(
                new View.OnClickListener() {

                    @Override
                    public void onClick(View v) {

                        InputConnection ic =
                                getCurrentInputConnection();

                        if (ic != null) {

                            ic.commitText(
                                    " ",
                                    1
                            );
                        }
                    }
                }
        );
    }


    // =========================================================
    // ENTER
    // =========================================================

    private void setEnter(int id) {

        Button button =
                keyboard.findViewById(id);

        if (button == null) {
            return;
        }

        button.setOnClickListener(
                new View.OnClickListener() {

                    @Override
                    public void onClick(View v) {

                        InputConnection ic =
                                getCurrentInputConnection();

                        if (ic != null) {

                            ic.commitText(
                                    "\n",
                                    1
                            );
                        }
                    }
                }
        );
    }


    // =========================================================
    // SHOW PAGE 1
    // =========================================================

    private void showPage1() {

        shiftOn = false;

        page1.setVisibility(
                View.VISIBLE
        );

        page2.setVisibility(
                View.GONE
        );
    }
}
