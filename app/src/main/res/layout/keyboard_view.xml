            android:layout_weight="1"
            android:layout_margin="3dp"
            android:gravity="center"
            android:background="#FFFFFF"
            android:text="ب"
            android:textColor="#000000"
            android:textSize="30sp" />

        <TextView
            android:layout_width="0dp"
