                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_za" android:text="ز"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button
                android:id="@+id/key_shift"
                android:text="SHIFT"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:minWidth="0dp"
                android:padding="0dp"
                style="@style/KeyboardButton"/>

        </LinearLayout>


        <!-- ROW 4 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_enter"
                android:text="ENTER"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:minWidth="0dp"
                android:padding="0dp"
                style="@style/KeyboardButton"/>

            <Button
                android:id="@+id/key_arrow"
                android:text="←"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:padding="0dp"
                style="@style/KeyboardButton"/>

            <Button
                android:id="@+id/key_punctuation"
