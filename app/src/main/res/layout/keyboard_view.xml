                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_th" android:text="ٿ"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_ta1" android:text="ت"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_ray" android:text="ر"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_yay" android:text="ي"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_sad" android:text="ص"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_qaf" android:text="ق"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

        </LinearLayout>


        <!-- ROW 2
             ڍ ڱ ک ل ڪ ج ه گ ف د س ا
        -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal">

            <Button android:id="@+id/key_ddal" android:text="ڍ"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_ng" android:text="ڱ"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_khay" android:text="ک"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_lam" android:text="ل"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_kaf" android:text="ڪ"
