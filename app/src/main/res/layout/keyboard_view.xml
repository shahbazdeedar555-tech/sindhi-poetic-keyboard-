            android:layoutDirection="rtl">

            <Button android:id="@+id/s13" android:text="۽" style="@style/KeyboardButton"/>
            <Button android:id="@+id/s14" android:text="ح" style="@style/KeyboardButton"/>
            <Button android:id="@+id/s15" android:text="ڦ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/s17" android:text="ڊ" style="@style/KeyboardButton"/>
            <Button android:id="@+id/s24" android:text="ش" style="@style/KeyboardButton"/>
