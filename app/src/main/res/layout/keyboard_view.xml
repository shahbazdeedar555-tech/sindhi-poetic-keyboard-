

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#173F35"
    android:padding="6dp">

    <!-- HEADER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="سنڌي شاعري ڪي بورڊ"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:includeFontPadding="false" />

    <!-- ROW 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_alif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ا"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_bay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ب"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_pay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="پ"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_tay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ت"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_tt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ٽ"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

    </LinearLayout>

    <!-- ROW 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_jay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ج"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_chay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ڃ"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_hay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ح"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_khay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="خ"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_dal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="د"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

    </LinearLayout>

    <!-- ROW 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_r"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ر"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_s"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="س"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_sh"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ش"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_sad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ص"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_dad"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ض"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

    </LinearLayout>

    <!-- ROW 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_tah"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ط"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_zah"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="ظ"
            android:textSize="18sp"
            android:includeFontPadding="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_ain"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
