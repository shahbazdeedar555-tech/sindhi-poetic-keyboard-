                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_dal" android:text="د"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_seen" android:text="س"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_alif" android:text="ا"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

        </LinearLayout>


        <!-- ROW 3
             DELETE ئ م ن ب ڀ ط خ ز SHIFT
        -->

        <LinearLayout
