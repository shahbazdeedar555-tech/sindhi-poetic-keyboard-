                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

        </LinearLayout>


        <!-- ROW 6 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal">

            <Button android:id="@+id/key_num0" android:text="0"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_num9" android:text="9"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_num8" android:text="8"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_num7" android:text="7"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_num6" android:text="6"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_num5" android:text="5"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_num4" android:text="4"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
                android:padding="0dp" style="@style/KeyboardButton"/>

            <Button android:id="@+id/key_num3" android:text="3"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:minWidth="0dp"
