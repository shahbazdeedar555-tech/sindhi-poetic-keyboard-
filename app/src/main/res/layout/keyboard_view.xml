        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_alif"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ا"
            android:textSize="22sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_bay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ب"
            android:textSize="22sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_pay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="پ"
            android:textSize="22sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_bhay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ڀ"
            android:textSize="22sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_tay"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ت"
            android:textSize="22sp"
            android:minWidth="0dp"
            android:padding="0dp" />

    </LinearLayout>

    <!-- ROW 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ٺ"
            android:textSize="22sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <Button
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ٽ"
            android:textSize="22sp"
            android:minWidth="0dp"
            android:padding="0dp" />

        <Button
