            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="right"
            android:layoutDirection="rtl">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="ـ" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="َ" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="ِ" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="ُ" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="ْ" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="ّ" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="ٰ" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="آ" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="ي" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="ئ" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="ى" />

        </LinearLayout>

    </LinearLayout>


    <!-- ٻيو حصو: Shift -->

