<LinearLayout
    android:id="@+id/keyboard_page1"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- ROW 1 -->
    <!-- چ ڇ پ و ڳ ع ٿ ت ر ي ص ق -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button android:id="@+id/key_ch" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="چ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_chh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڇ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_pay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="پ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_waw" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="و" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_ghain" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڳ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_ain" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ع" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_th" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ٿ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_ta1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ت" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_ray" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ر" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_yay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ي" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_sad" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ص" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_qaf" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ق" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>

    </LinearLayout>

    <!-- ROW 2 -->
    <!-- ڍ ڱ ک ل ل ج ه گ ف د س ا -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button android:id="@+id/key_ddal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڍ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_ng" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڱ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_khay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ک" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_lam" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ل" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_lam2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ل" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_jeem" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ج" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_hay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ه" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_gaf" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="گ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_fay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ف" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_dal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="د" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_seen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="س" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_alif" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ا" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>

    </LinearLayout>

    <!-- ROW 3 -->
    <!-- ئ م ن ب ڀ ط خ ز -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button android:id="@+id/key_hamza_y" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ئ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_meem" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="م" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_noon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ن" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_bay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ب" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_bh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڀ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_ta2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ط" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_kha" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="خ" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_za" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ز" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>

    </LinearLayout>

    <!-- ROW 4 : SHIFT DELETE -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button android:id="@+id/key_shift" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:text="SHIFT" android:textColor="#FFFFFF" android:textSize="15sp" android:background="#000000"/>

        <Button android:id="@+id/key_delete" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:text="DELETE" android:textColor="#FFFFFF" android:textSize="15sp" android:background="#000000"/>

    </LinearLayout>

    <!-- SYMBOLS -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <Button android:id="@+id/key_colon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=":" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_semicolon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="؛" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_question" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="؟" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_quote1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="“" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_quote2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="”" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_underscore" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="_" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_exclamation" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="!" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>
        <Button android:id="@+id/key_ellipsis" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="…" android:textColor="#FFFFFF" android:textSize="20sp" android:background="#000000"/>

    </LinearLayout>

    <!-- BOTTOM -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button android:id="@+id/key_enter" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:text="ENTER" android:textColor="#FFFFFF" android:textSize="15sp" android:background="#000000"/>

        <Button android:id="@+id/key_space" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:text="SPACE" android:textColor="#FFFFFF" android:textSize="15sp" android:background="#000000"/>

    </LinearLayout>

</LinearLayout>


