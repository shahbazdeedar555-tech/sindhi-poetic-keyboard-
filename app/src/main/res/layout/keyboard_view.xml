

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="300dp"
    android:orientation="vertical"
    android:background="#173F35"
    android:padding="2dp">

    <!-- ===================================== -->
    <!-- PAGE 1 -->
    <!-- ===================================== -->

    <LinearLayout
        android:id="@+id/keyboard_page1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Row 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_ch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="چ"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_chh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ڇ"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_pay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="پ"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_waw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="و"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_ghain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ڳ"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_ain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ع"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_th"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ٿ"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_ta1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ت"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_ray"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ر"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_yay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ي"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_sad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ص"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_qaf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ق"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>
        </LinearLayout>

        <!-- Row 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <Button android:id="@+id/key_ddal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڍ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_ng" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڱ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_khay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ک" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_lam" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ل" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_lam2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ل" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_jeem" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ج" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_hay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ه" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_gaf" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="گ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_fay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ف" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_dal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="د" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_seen" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="س" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_alif" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ا" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
        </LinearLayout>

        <!-- Row 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <Button android:id="@+id/key_hamza_y" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ئ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_meem" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="م" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_noon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ن" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_bay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ب" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_bh" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڀ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_ta2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ط" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_kha" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="خ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_za" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ز" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
        </LinearLayout>

        <!-- Controls -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_shift"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="SHIFT"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_delete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DELETE"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>
        </LinearLayout>

        <!-- Symbols -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <Button android:id="@+id/key_colon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=":" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_semicolon" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="؛" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_question" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="؟" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_quote1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="“" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_quote2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="”" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_underscore" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="_" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_exclamation" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="!" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_ellipsis" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="…" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
        </LinearLayout>

        <!-- Bottom -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ENTER"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:text="SPACE"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>
        </LinearLayout>

    </LinearLayout>

    <!-- ===================================== -->
    <!-- PAGE 2 -->
    <!-- ===================================== -->

    <LinearLayout
        android:id="@+id/keyboard_page2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Row 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <Button android:id="@+id/s1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڄ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڃ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڦ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ھ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="غ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ث" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s7" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ٽ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s8" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڙ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
        </LinearLayout>

        <!-- Row 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <Button android:id="@+id/s9" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ض" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ٺ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڌ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڏ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="۽" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ح" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڊ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ش" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
        </LinearLayout>

        <!-- Row 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <Button android:id="@+id/s17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="آ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="۾" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ڻ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s20" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ٻ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s21" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ء" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s22" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ظ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/s23" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ذ" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
        </LinearLayout>

        <!-- Controls -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_shift2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="SHIFT"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_delete2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="DELETE"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>
        </LinearLayout>

        <!-- Symbols -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <Button android:id="@+id/key_colon2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text=":" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_semicolon2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="؛" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_question2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="؟" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
            <Button android:id="@+id/key_exclamation2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="!" android:textSize="20sp" android:textColor="#FFFFFF" android:background="#000000"/>
        </LinearLayout>

        <!-- Bottom -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_enter2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ENTER"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>

            <Button
                android:id="@+id/key_space2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:text="SPACE"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:background="#000000"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
