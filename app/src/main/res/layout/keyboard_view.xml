
<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="300dp"
    android:orientation="vertical"
    android:background="#173F35"
    android:padding="2dp">

    <!-- ================================================= -->
    <!-- PAGE 1 : BASIC SINDHI LETTERS                     -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/keyboard_page1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- ROW 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_ch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="چ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_chh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ڇ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_pay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="پ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_waw"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="و"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_ghain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ڳ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_ain"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ع"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_th"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ٿ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_tay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ت"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

        </LinearLayout>

        <!-- ROW 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_ray"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ر"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_yay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ي"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_sad"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ص"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_qaf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ق"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_ddal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ڍ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_ng"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ڱ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_khay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ک"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_lam"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ل"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_kaf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ڪ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_jeem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ج"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

        </LinearLayout>

        <!-- ROW 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_hay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ه"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_gaf"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="گ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_fay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ف"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_dal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="د"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_seen"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="س"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_alif"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ا"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

        </LinearLayout>

        <!-- ROW 4 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_delete"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="ڊليٽ"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_hamza_y"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ئ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_meem"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="م"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_noon"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ن"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_bay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ب"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_bh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ڀ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_ta"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ط"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_kha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="خ"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_za"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ز"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_shift"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.4"
                android:text="شفٽ"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="#000000" />

        </LinearLayout>

        <!-- BOTTOM CONTROL ROW -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/key_enter"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:text="انٽر"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_arrow"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="ايرو"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_symbols"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:text="نشانيون"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_space"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2.5"
                android:text="اسپيس"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:background="#000000" />

            <Button
                android:id="@+id/key_123"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:text="123"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:background="#000000" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
